{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingMaxDescChars": 700,
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-pipeline.sh\"",
            "statusMessage": "Pipeline reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-lock-gate.sh\"",
            "statusMessage": "Multi-window lock gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-checks.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-status.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompact-preserve.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "PowerShell(Remove-Item * -Recurse -Force*)",
      "PowerShell(*DROP DATABASE*)",
      "PowerShell(*DROP TABLE*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.*)",
      "Read(./backend/**/.env)",
      "Read(./backend/**/.env.*)",
      "Read(./backend/**/appsettings.Production.json)",
      "Read(./deploy/**/.env)",
      "Read(./deploy/**/.env.*)",
      "Read(./deploy/**/*.key)",
      "Read(./deploy/**/*.pem)",
      "Read(./deploy/**/*.pfx)",
      "Read(./.claude/worktrees/**/.env)",
      "Read(./.claude/worktrees/**/.env.*)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push *)",
      "PowerShell(git push*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow run *)",
      "Bash(gcloud *)",
      "PowerShell(gcloud *)"
    ],
    "allow": [
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(git worktree list)",
      "Bash(git pull --ff-only:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh secret list)",
      "Bash(dotnet build:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx cypress:*)",
      "Bash(npx playwright test:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
