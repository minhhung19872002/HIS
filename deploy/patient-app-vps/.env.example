# Mau bien moi truong cho stack tren VPS Cloud (HSMT muc II).
# Copy thanh .env roi dien gia tri that. TUYET DOI khong commit file .env.

# --- Domain cong khai ---------------------------------------------------------
# Caddy se tu xin chung chi DV SSL (Let's Encrypt) cho domain nay.
PATIENTAPP_DOMAIN=
# Email nhan canh bao truoc khi chung chi het han.
ACME_EMAIL=

# --- Khoa dung chung voi BFF trong data center --------------------------------
# Phai TRUNG voi PushRelay:ApiKey ben BFF. Toi thieu 24 ky tu.
# Sinh: openssl rand -base64 32
RELAY_API_KEY=

# --- Firebase Cloud Messaging -------------------------------------------------
# DE TRONG CUNG CHAY DUOC. Thieu cau hinh Firebase thi relay chay o CHE DO GIA: thong bao chi
# duoc ghi vao log chu khong toi may nguoi benh. Du de dung ca tang VPS len va nghiem thu muc II
# (VPS khong giu du lieu y te, chi mo /push va /health, ngan sach RAM/dia) ma khong can khoa nao.
# Kiem dang chay che do nao: curl http://127.0.0.1/health  ->  "mode":"fake" hoac "fcm".
#
# ⚠️ Truoc khi phat hanh toi nguoi benh that PHAI dat day du va kiem lai "mode":"fcm".
#
# Lay o Firebase Console > Project settings > General.
FCM_PROJECT_ID=
# Khoa tai khoan dich vu tai ve tu Firebase Console > Service accounts,
# luu thanh ./secrets/fcm-service-account.json. KHONG commit.

# De trong thi compose tu build relay tu ma nguon trong repo (backend/src/HIS.PatientApp.Relay).
# Chi dat khi ban da co san mot anh dung roi.
# RELAY_IMAGE=
