# Mau bien moi truong cho stack tai DATA CENTER BENH VIEN (HSMT muc I).
# Copy thanh .env roi dien gia tri that. TUYET DOI khong commit file .env.

# --- CSDL rieng cua app -------------------------------------------------------
PATIENTAPP_DB_NAME=his_patientapp
PATIENTAPP_DB_USER=patientapp
# Sinh ngau nhien: openssl rand -base64 32
PATIENTAPP_DB_PASSWORD=

# --- Khoa ky token cua app ----------------------------------------------------
# Toi thieu 32 ky tu. RIENG BIET voi khoa cua HIS Core.
# Sinh: openssl rand -base64 48
PATIENTAPP_JWT_KEY=

# --- Ket noi HIS Core ---------------------------------------------------------
# Dia chi NOI BO trong data center, vi du http://his-api:8080
HIS_CORE_BASE_URL=
# Tai khoan dich vu tren HIS: vai tro rieng, quyen toi thieu.
# KHONG dung lai tai khoan admin — tai khoan nay nhin duoc ho so cua moi benh nhan.
HIS_SERVICE_USERNAME=
HIS_SERVICE_PASSWORD=

# --- Anh va cong --------------------------------------------------------------
PATIENTAPP_IMAGE=ghcr.io/minhhung19872002/his-patientapp-api:latest
PATIENTAPP_API_PORT=8090
