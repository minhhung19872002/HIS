<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HIS.Tools.ModalitySimulator</RootNamespace>
    <AssemblyName>ModalitySimulator</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same fo-dicom version as HIS.Infrastructure so the simulator exercises the exact stack
         the server side is built on. -->
    <PackageReference Include="fo-dicom" Version="5.2.0" />
  </ItemGroup>

</Project>
