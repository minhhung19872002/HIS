# Podfile cho app ho tro nguoi benh.
#
# Dat tuong minh platform :ios, '12.0' — dung dong "iOS 12.0 tro len" cua ho so moi thau.
# Neu de Flutter tu sinh Podfile, no lay muc mac dinh cua ban Flutter dang chay va se AM THAM
# nang muc toi thieu len khi ai do doi ban SDK. Xem docs/features/patient-app/README.md §6.2.
platform :ios, '12.0'

# Tat gui thong ke ban dung ve CocoaPods.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Chay `flutter pub get` truoc."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT khong co trong #{generated_xcode_build_settings_path}. Xoa roi chay lai `flutter pub get`."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Bat buoc phai co use_frameworks!: cac pod viet bang Swift (pdfrx, biometric_signature...)
  # khong tich hop duoc duoi dang thu vien tinh thuan tuy — CocoaPods bao thang
  # "The following Swift pods cannot yet be integrated as static libraries".
  #
  # Dung :linkage => :static de van goi thanh framework nhung lien ket tinh: cach nay giu duoc
  # kich thuoc ban dong goi va la cach Firebase khuyen dung.
  #
  # Doi lai, Firebase iOS SDK 10.x (di kem firebase_messaging 14.x — nhanh cuoi cung con ho tro
  # iOS 12) tron header modular va khong modular, nen phai bat
  # CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES o post_install ben duoi.
  # KHONG dung use_frameworks!. Day la mau chot de giu duoc iOS 12.
  #
  # Firebase iOS SDK 10.x — nhanh cuoi cung con ho tro iOS 12 — co pod `Firebase` chi-co-header,
  # khong co file nguon, nen CocoaPods khong dung framework cho no duoc: header nam o
  # Pods/Headers/Public/Firebase/Firebase.h, tuc KHONG modular. Bat use_frameworks! thi
  # firebase_messaging tro thanh framework module, ma header cua no lai `#import <Firebase/Firebase.h>`
  # — Clang cam include header khong modular tu ben trong framework module, va build dung.
  #
  # Bo use_frameworks! thi khong con framework module nao, lenh include kia tro thanh include
  # thuong va hop le. Doi lai, cac pod Swift doi phu thuoc cua chung phai co module map:
  #   * DKPhotoGallery (do file_picker keo vao) can SDWebImage
  #   * FirebaseCoreInternal can GoogleUtilities
  # use_modular_headers! sinh module map cho moi pod, dung nhu CocoaPods goi y trong thong bao loi.
  #
  # Da thu va KHONG hieu qua, ghi lai de khoi thu lai:
  #   * chi dat CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES
  #   * use_frameworks! :linkage => :static
  #   * khai :modular_headers => true rieng cho tung pod Firebase
  #   * tat ENABLE_MODULE_VERIFIER
  #   * use_frameworks! di kem use_modular_headers!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # flutter_additional_ios_build_settings co the keo muc toi thieu len theo ban Flutter.
      # Ep lai 12.0 de moi pod cung build cho iOS 12 — mot pod doi cao hon se lam ca app mat iOS 12.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'

      # Firebase iOS SDK 10.x tron lan header modular va khong modular:
      # FLTFirebaseMessagingPlugin.h co dong `#import <Firebase/Firebase.h>` ma Firebase.h khong
      # phai module. Hai co duoi day di CUNG NHAU moi du:
      #
      #   * CLANG_ALLOW_NON_MODULAR_INCLUDES... cho phep trinh bien dich chap nhan.
      #   * ENABLE_MODULE_VERIFIER = NO. Tu Xcode 15, module verifier chay MOT LUOT RIENG voi bo co
      #     nghiem ngat cua no va BO QUA co o tren, nen chi dat mot minh co dau tien thi build van
      #     dung dung cho do. Runner dang dung Xcode 16.4.
      #
      # Chi tat verifier cho POD, khong dung toi ma nguon cua app.
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

      # Quyen cho cac plugin dung permission_handler: chi bat dung nhung quyen app thuc su xin,
      # de App Store khong hoi ve nhung quyen khong dung toi.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_CAMERA=1',
      ]
    end
  end
end
