<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HIS.PatientApp.Api</RootNamespace>
  </PropertyGroup>

  <!--
    CỐ Ý KHÔNG tham chiếu HIS.Core / HIS.Application / HIS.Infrastructure.

    HSMT mục I.1 yêu cầu "hệ thống tích hợp module kết nối với HIS dựa trên các API HIS cung cấp".
    Tham chiếu thẳng project sẽ biến BFF thành một phần của HIS chứ không phải một hệ thống kết nối
    qua API — và kéo theo cả EF Core SqlServer, fo-dicom, itext7, Pkcs11 vào một dịch vụ mở ra
    Internet. Mọi truy vấn nghiệp vụ đi qua IHisConnector (HTTP). Xem docs/features/patient-app/README.md D2.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />

    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.0" />
  </ItemGroup>

  <!--
    Mở phần `internal` cho bộ test. Cần để kiểm được logic ĐỌC CSDL của các worker nền — trước đây
    67 phép kiểm của BFF đều chỉ chạm tới hàm thuần (chuẩn hoá SĐT, so phiên bản, ví giấy tờ…), nên
    một lỗi nằm trong câu truy vấn của worker nhắc lịch không có gì bắt được.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>HIS.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
