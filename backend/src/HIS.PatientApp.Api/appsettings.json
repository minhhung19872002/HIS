{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "PatientAppDb": "Host=localhost;Port=5439;Database=his_patientapp;Username=patientapp;Password=CHANGE_ME"
  },

  "AppJwt": {
    "Issuer": "HIS.PatientApp",
    "Audience": "HIS.PatientApp.Mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60,
    "Key": ""
  },

  "AppointmentReminder": {
    "Enabled": true,
    "PollIntervalMinutes": 10,
    "SyncBatchSize": 50,
    "ActiveWithinDays": 45
  },

  "PushRelay": {
    "//": "Để trống BaseUrl = không đẩy thông báo; thông báo vẫn vào hộp thư trong app.",
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 15,
    "MaxAttempts": 5,
    "PollIntervalSeconds": 10,
    "BatchSize": 50
  },

  "HisJwt": {
    "//": "Khoa/issuer/audience cua HIS Core — de BFF xac thuc token nhan vien o API quan tri.",
    "Issuer": "HIS.API",
    "Audience": "HIS.Client",
    "Key": ""
  },

  "DocumentVault": {
    "//": "Khoa AES-256 base64 (openssl rand -base64 32). Bat buoc ngoai moi truong Development.",
    "RootPath": "vault",
    "Key": "",
    "MaxFileMegabytes": 10,
    "QuotaMegabytesPerAccount": 100
  },

  "HisConnector": {
    "BaseUrl": "http://localhost:5106",
    "ServiceUsername": "",
    "ServicePassword": "",
    "TimeoutSeconds": 20,
    "CatalogCacheMinutes": 10
  }
}
